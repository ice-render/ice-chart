{
  "author": "大漠穷秋",
  "name": "@damoqiongqiu/ice-chart",
  "version": "0.19.1",
  "license": "MIT",
  "description": "基于 ice-render Canvas 引擎的交互式图表库：命中测试与事件派发由引擎承担，图表层只做「数据 ↔ 像素 ↔ 语义事件」。",
  "keywords": [
    "chart",
    "canvas",
    "visualization",
    "interaction",
    "ice-render",
    "dashboard",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice-render/ice-chart.git"
  },
  "homepage": "https://github.com/ice-render/ice-chart#readme",
  "bugs": {
    "url": "https://github.com/ice-render/ice-chart/issues"
  },
  "type": "commonjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "browser": "dist/index.umd.js",
  "main": "dist/index.cjs",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "start": "rollup -c -w --environment NODE_ENV:development",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c --environment NODE_ENV:production",
    "build:types": "tsc --emitDeclarationOnly && node scripts/emit-dmts.cjs",
    "clean": "rimraf dist",
    "pretty": "prettier src tests scripts --write",
    "pretty:check": "prettier src tests scripts --check",
    "types:check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "examples:prepare": "node scripts/prepare-examples.cjs",
    "examples:serve": "npm run examples:prepare && node scripts/serve-examples.cjs",
    "audit:interactions": "node scripts/audit-interactions.mjs",
    "audit:hover": "node scripts/hover-sweep.mjs",
    "prepublishOnly": "npm run verify",
    "verify": "npm run lint && npm run types:check && npm run build && npm test -- --runInBand",
    "test:e2e": "npm run build && npm run examples:prepare && playwright test",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "peerDependencies": {
    "ice-render": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@damoqiongqiu/ice-chart-dsl": "^0.1.3",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "28.0.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-strip": "3.0.4",
    "@rollup/plugin-terser": "0.4.4",
    "@types/jest": "29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "29.7.0",
    "eslint": "^8.57.1",
    "ice-render": "^2.3.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.1",
    "rimraf": "5.0.10",
    "rollup": "3.29.5",
    "rollup-plugin-license": "3.6.0",
    "rollup-plugin-visualizer": "6.0.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
